
<link rel="stylesheet" href="./css/main.css">

<h1>Добро пожаловать!</h1>

<div class="auth-container">

    <!-- Регистрация -->
    <div class="auth-card">
        <h2>Регистрация</h2>

        <form action="/register" method="POST" novalidate>

            <input
                type="text"
                name="username"
                placeholder="Ваше имя"
                value="{{registerValues.username}}"
                required
            >

            {{#if registerErrors.username}}
                <p class="error">{{registerErrors.username}}</p>
            {{/if}}

            <input
                type="email"
                name="email"
                placeholder="Email"
                value="{{registerValues.email}}"
                required
            >

            {{#if registerErrors.email}}
                <p class="error">{{registerErrors.email}}</p>
            {{/if}}

            <input
                type="password"
                name="password"
                placeholder="Пароль (минимум 9 символов)"
                minlength="9"
                required
            >

            {{#if registerErrors.password}}
                <p class="error">{{registerErrors.password}}</p>
            {{/if}}

            <button type="submit">Создать аккаунт</button>
        </form>
    </div>

    <!-- Авторизация -->
    <div class="auth-card">
        <h2>Вход</h2>

        <form action="/login" method="POST" novalidate>

            <input
                type="email"
                name="email"
                placeholder="Email"
                value="{{loginValues.email}}"
                required
            >

            {{#if loginErrors.email}}
                <p class="error">{{loginErrors.email}}</p>
            {{/if}}

            <input
                type="password"
                name="password"
                placeholder="Пароль"
                minlength="9"
                required
            >

            {{#if loginErrors.password}}
                <p class="error">{{loginErrors.password}}</p>
            {{/if}}

            <button type="submit">Войти</button>
        </form>
    </div>

</div>
